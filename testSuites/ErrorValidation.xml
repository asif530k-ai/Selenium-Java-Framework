<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite parallel="methods" name="Suite">


<groups>
<run>
<include name="ErrorHandling"></include>
</run>

</groups>

  <test thread-count="5" name="Stand Alone Test">
    <classes>
      <class name="rahulshettyacademy.tests.standAloneTest"/>
    </classes>
  </test>
    
   <test thread-count="5" name="Error Validation Test">
    <classes>
      <class name="rahulshettyacademy.tests.ErrorValidations"/>
    </classes>
  </test>
    

</suite> <!-- Suite -->
